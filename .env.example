# Create a REST app at https://developer.paypal.com/dashboard/applications/sandbox
# and copy its credentials here. Never commit the filled-in .env.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# The chat advisor. Create a key at console.anthropic.com -> API keys.
# Without it the app runs and /api/agent/status reports configured: false;
# the chat sheet shows "Advisor not connected" instead of failing.
ANTHROPIC_API_KEY=

# Optional. Defaults: claude-opus-5-5 at low effort -- the engine does the
# reasoning that matters, so the model's job is small and should be fast.
# POINTWISE_AGENT_MODEL=claude-opus-5-5
# POINTWISE_AGENT_EFFORT=low

# Transaction aggregation. A sandbox key pair from dashboard.plaid.com is free
# and needs no real bank: /api/plaid/sandbox-link then mints a connected test
# issuer with credit cards and a month of transactions, no Link UI required.
# Without these the app runs and /api/plaid/status reports configured: false.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
